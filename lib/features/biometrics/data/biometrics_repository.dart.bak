import 'package:health/health.dart';

class BiometricsSnapshot {
  const BiometricsSnapshot({
    required this.heartRate,
    required this.recordedAt,
    required this.stateLabel,
    required this.stateScore,
    required this.isAvailable,
  });

  final int? heartRate;
  final DateTime? recordedAt;
  final String stateLabel;
  final int stateScore;
  final bool isAvailable;
}

class BiometricsRepository {
  final Health _health = Health();

  bool _authorizationChecked = false;
  bool _hasAuthorization = false;

  Future<BiometricsSnapshot> fetchLatestSnapshot() async {
    try {
      const types = [HealthDataType.HEART_RATE];
      const permissions = [HealthDataAccess.READ];

      if (!_authorizationChecked) {
        try {
          _hasAuthorization =
              await _health.hasPermissions(
                    types,
                    permissions: permissions,
                  ) ??
                  false;
        } catch (_) {
          _hasAuthorization = false;
        }

        if (!_hasAuthorization) {
          _hasAuthorization = await _health.requestAuthorization(
            types,
            permissions: permissions,
          );
        }

        _authorizationChecked = true;
      }

      if (!_hasAuthorization) {
        return const BiometricsSnapshot(
          heartRate: null,
          recordedAt: null,
          stateLabel: 'Нет доступа',
          stateScore: 0,
          isAvailable: false,
        );
      }

      final now = DateTime.now();
      final from = now.subtract(const Duration(hours: 2));

      final data = await _health.getHealthDataFromTypes(
        types: types,
        startTime: from,
        endTime: now,
      );

      final cleaned = _health.removeDuplicates(data);

      final heartRatePoints =
          cleaned
              .where((item) => item.type == HealthDataType.HEART_RATE)
              .where((item) => _extractNumericValue(item.value) != null)
              .toList()
            ..sort((a, b) {
              final byDateTo = b.dateTo.compareTo(a.dateTo);
              if (byDateTo != 0) return byDateTo;
              return b.dateFrom.compareTo(a.dateFrom);
            });

      if (heartRatePoints.isEmpty) {
        return const BiometricsSnapshot(
          heartRate: null,
          recordedAt: null,
          stateLabel: 'Нет данных',
          stateScore: 0,
          isAvailable: false,
        );
      }

      final latest = heartRatePoints.first;
      final heartRate = _extractNumericValue(latest.value)?.round();

      if (heartRate == null) {
        return const BiometricsSnapshot(
          heartRate: null,
          recordedAt: null,
          stateLabel: 'Нет данных',
          stateScore: 0,
          isAvailable: false,
        );
      }

      final state = _deriveStateFromHeartRate(heartRate);

      return BiometricsSnapshot(
        heartRate: heartRate,
        recordedAt: latest.dateTo,
        stateLabel: state.label,
        stateScore: state.score,
        isAvailable: true,
      );
    } catch (_) {
      return const BiometricsSnapshot(
        heartRate: null,
        recordedAt: null,
        stateLabel: 'Ошибка чтения',
        stateScore: 0,
        isAvailable: false,
      );
    }
  }

  double? _extractNumericValue(dynamic value) {
    if (value == null) return null;

    if (value is num) return value.toDouble();

    final raw = value.toString();
    final match = RegExp(r'(\d+(\.\d+)?)').firstMatch(raw);
    if (match == null) return null;

    return double.tryParse(match.group(1)!);
  }

  _DerivedState _deriveStateFromHeartRate(int heartRate) {
    if (heartRate >= 110) {
      return const _DerivedState(label: 'Критично', score: 4);
    }

    if (heartRate >= 90) {
      return const _DerivedState(label: 'Напряжение', score: 3);
    }

    if (heartRate >= 75) {
      return const _DerivedState(label: 'Норма', score: 2);
    }

    return const _DerivedState(label: 'Спокойно', score: 1);
  }
}

class _DerivedState {
  const _DerivedState({
    required this.label,
    required this.score,
  });

  final String label;
  final int score;
}
