class HomeScreen extends StatefulWidget {
  const HomeScreen({super.key});

  @override
  State<HomeScreen> createState() => _HomeScreenState();
}

class _HomeScreenState extends State<HomeScreen> with WidgetsBindingObserver {
  final BiometricsRepository _biometricsRepository = BiometricsRepository();
  final SessionsRepository _sessionsRepository = SessionsRepository();

  dynamic _biometricsSnapshot;
  bool _isRefreshingState = true;
  bool _isStartingAiSession = false;

  StateLevel get _currentLevel {
    final rawScore = (_biometricsSnapshot?.stateScore as int?) ?? 2;
    final safeScore = rawScore < 1 || rawScore > 4 ? 2 : rawScore;
    return StateLevel.values[safeScore - 1];
  }

  @override
  void initState() {
    super.initState();
    WidgetsBinding.instance.addObserver(this);
    _loadBiometrics();
  }

  @override
  void dispose() {
    WidgetsBinding.instance.removeObserver(this);
    super.dispose();
  }

  @override
  void didChangeAppLifecycleState(AppLifecycleState state) {
    super.didChangeAppLifecycleState(state);
    if (state == AppLifecycleState.resumed && mounted) {
      _loadBiometrics();
    }
  }

  String _resolveUserName(User? user) {
    final metadata = user?.userMetadata;

    final nameFromName = metadata?['name']?.toString().trim();
    if (nameFromName != null && nameFromName.isNotEmpty) {
      return nameFromName;
    }

    final nameFromFullName = metadata?['full_name']?.toString().trim();
    if (nameFromFullName != null && nameFromFullName.isNotEmpty) {
      return nameFromFullName;
    }

    final email = user?.email?.trim();
    if (email != null && email.isNotEmpty && email.contains('@')) {
      return email.split('@').first;
    }

    return 'Пользователь';
  }

  String _greeting() {
    final hour = DateTime.now().hour;
    if (hour >= 5 && hour < 12) return 'Доброе утро,';
    if (hour >= 12 && hour < 18) return 'Добрый день,';
    return 'Добрый вечер,';
  }

  Future<void> _loadBiometrics() async {
    if (mounted) {
      setState(() {
        _isRefreshingState = true;
      });
    }

    try {
      final snapshot = await _biometricsRepository.fetchLatestSnapshot();

      if (!mounted) return;

      setState(() {
        _biometricsSnapshot = snapshot;
        _isRefreshingState = false;
      });
    } catch (_) {
      if (!mounted) return;

      setState(() {
        _isRefreshingState = false;
      });
    }
  }

  Future<void> _refreshState() async {
    if (_isRefreshingState) return;
    await _loadBiometrics();
  }

  String _recommendedModeTitle(StateLevel level) {
    switch (level.number) {
      case 1:
        return 'Мягкая поддержка';
      case 2:
        return 'Быстрый reset';
      case 3:
        return 'Восстановление';
      case 4:
        return 'Срочная помощь';
      default:
        return 'Подходящий режим';
    }
  }

  String _recommendedModeKey(StateLevel level) {
    switch (level.number) {
      case 1:
        return 'softsupport';
      case 2:
        return 'quickreset';
      case 3:
        return 'recovery';
      case 4:
        return 'urgenthelp';
      default:
        return 'custom';
    }
  }

  String _aiTitle(StateLevel level) {
    switch (level.number) {
      case 1:
        return 'AI рекомендует мягкую поддержку';
      case 2:
        return 'AI рекомендует короткий reset';
      case 3:
        return 'AI рекомендует восстановление';
      case 4:
        return 'AI рекомендует срочную помощь';
      default:
        return 'AI рекомендует подходящий режим';
    }
  }

  String _aiSubtitle(StateLevel level) {
    final snapshot = _biometricsSnapshot;
    final isAvailable = (snapshot?.isAvailable as bool?) ?? false;

    if (!isAvailable) {
      return 'Данные Apple Health пока недоступны. Можно открыть режимы помощи и выбрать подходящий сценарий вручную.';
    }

    final heartRateValue = snapshot?.metricByKey('heart_rate')?.value;
    final heartRate = heartRateValue?.round();
    final stateLabelRaw = snapshot?.stateLabel?.toString() ?? '';

    final heartRateText = heartRate != null ? '$heartRate bpm' : 'без пульса';
    final stateLabel =
        stateLabelRaw.isNotEmpty ? stateLabelRaw : level.title.toLowerCase();

    switch (level.number) {
      case 1:
        return 'Сейчас состояние выглядит стабильным ($stateLabel, $heartRateText). Можно мягко поддержать ритм без перегруза.';
      case 2:
        return 'Замечено умеренное напряжение ($stateLabel, $heartRateText). Лучше сделать короткий reset и немного снизить внутренний шум.';
      case 3:
        return 'Сейчас заметна повышенная нагрузка ($stateLabel, $heartRateText). Лучше перейти в режим восстановления.';
      case 4:
        return 'Сигналы выглядят напряжённо ($stateLabel, $heartRateText). Лучше сразу открыть самый бережный сценарий помощи.';
      default:
        return 'Открой рекомендацию и начни подходящий сценарий помощи.';
    }
  }

  Future<void> _openAiRecommendation() async {
    if (_isStartingAiSession) return;

    final level = _currentLevel;
    final isAvailable = (_biometricsSnapshot?.isAvailable as bool?) ?? false;

    if (!isAvailable && level.number == 1) {
      context.go(AppRoutes.modes);
      return;
    }

    setState(() {
      _isStartingAiSession = true;
    });

    try {
      final modeTitle = _recommendedModeTitle(level);
      final modeKey = _recommendedModeKey(level);

      final sessionId = await _sessionsRepository.createSession(
        modeKey: modeKey,
        modeTitle: modeTitle,
        stressLevel: level.number,
        stressTitle: level.title,
        source: 'home_ai_recommendation',
      );

      if (!mounted) {
        return;
      }

      if (sessionId == null || sessionId.isEmpty) {
        ScaffoldMessenger.of(context).showSnackBar(
          const SnackBar(
            content: Text('Не удалось создать AI-сессию. Попробуй ещё раз.'),
          ),
        );
        return;
      }

      await context.push(
        AppRoutes.intervention,
        extra: {
          'sessionId': sessionId,
          'modeTitle': modeTitle,
          'source': 'home_ai_recommendation',
          'stressLevel': level.number,
          'stressTitle': level.title,
          'status': 'started',
        },
      );
    } catch (_) {
      if (!mounted) {
        return;
      }

      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
          content: Text('Не удалось открыть AI-рекомендацию. Попробуй ещё раз.'),
        ),
      );
    } finally {
      if (mounted) {
        setState(() {
          _isStartingAiSession = false;
        });
      }
    }
  }

  @override
  Widget build(BuildContext context) {
    final user = Supabase.instance.client.auth.currentUser;
    final userName = _resolveUserName(user);
    final level = _currentLevel;

    return Scaffold(
      backgroundColor: AppColors.background,
      body: SafeArea(
        child: RefreshIndicator(
          onRefresh: _loadBiometrics,
          child: SingleChildScrollView(
            physics: const AlwaysScrollableScrollPhysics(),
            padding: const EdgeInsets.fromLTRB(16, 8, 16, 24),
            child: Center(
              child: ConstrainedBox(
                constraints: const BoxConstraints(maxWidth: 460),
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    const _TopHeader(),
                    const SizedBox(height: 10),
                    _GreetingBlock(
                      greeting: _greeting(),
                      userName: userName,
                    ),
                    const SizedBox(height: 14),
                    StateHero(
                      level: level,
                      isRefreshing: _isRefreshingState,
                      onRefreshTap: _refreshState,
                      onTap: () {},
                    ),
                    const SizedBox(height: 12),
                    _AiRecommendationCard(
                      title: _isStartingAiSession
                          ? 'Открываем AI-рекомендацию...'
                          : _aiTitle(level),
                      subtitle: _aiSubtitle(level),
                      onTap: _openAiRecommendation,
                    ),
                    const SizedBox(height: 10),
                    _OpenModesCard(
                      onTap: () {
                        context.go(AppRoutes.modes);
                      },
                    ),
                  ],
                ),
              ),
            ),
          ),
        ),
      ),
    );
  }
}

